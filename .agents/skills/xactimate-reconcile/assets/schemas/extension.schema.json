        },
        "accessed_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "limitation": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        }
      },
      "required": [
        "id",
        "title",
        "url_or_document",
        "accessed_date",
        "limitation"
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "kind": {
          "enum": [
            "context",
            "cost_observation",
            "writing_example",
            "technical_note"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "amount": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?(?:0|[1-9][0-9]{0,17})(?:\\.[0-9]{1,8})?$"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": [

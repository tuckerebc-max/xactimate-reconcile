{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xactimate-reconcile:extension:1.0",
  "title": "Xactimate context extension pack",
  "description": "Reviewed context only; never automatically changes claim arithmetic.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "xr-extension/1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "type": {
      "enum": [
        "geography",
        "pricing",
        "exemplar",
        "technical",
        "carrier"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "jurisdiction": {
      "type": "object",
      "properties": {
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "municipality": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "country",
        "state",
        "municipality"
      ],
      "additionalProperties": false
    },
    "roof_types": {
      "type": "array",
      "items": {
        "enum": [
          "shingle",
          "tile",
          "low_slope"
        ]
      },
      "uniqueItems": true
    },
    "effective_from": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "effective_to": {
      "oneOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "draft",
            "reviewed"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewed_at"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "url_or_document": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "accessed_date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "limitation": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          }
        },
        "required": [
          "id",
          "title",
          "url_or_document",
          "accessed_date",
          "limitation"
        ],
        "additionalProperties": false
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "kind": {
            "enum": [
              "context",
              "cost_observation",
              "writing_example",
              "technical_note"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "amount": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?(?:0|[1-9][0-9]{0,17})(?:\\.[0-9]{1,8})?$"
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_at": {
            "oneOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_at": {
            "oneOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "artifact_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "content",
          "source_ids",
          "amount",
          "unit",
          "currency",
          "observed_at",
          "expires_at",
          "artifact_path",
          "artifact_sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "type",
    "title",
    "jurisdiction",
    "roof_types",
    "effective_from",
    "effective_to",
    "review",
    "sources",
    "entries"
  ],
  "additionalProperties": false,
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
        },
        "title": {
